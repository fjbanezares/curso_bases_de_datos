# ==============================================================================
# 🔑 ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env) PARA PYTHON
# ==============================================================================
# Renombra este archivo a '.env' y completa con tus credenciales de Supabase.
# ==============================================================================

# 1. Conexión recomendada con Session Pooler (Soporte IPv4)
# En Supabase: Project Settings -> Database -> Connection string -> Mode: Session
DATABASE_SES_URL="postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# 2. Parámetros desglosados (Ideal si la contraseña contiene '@', sin codificar):
DB_HOST="aws-0-eu-central-1.pooler.supabase.com"
DB_PORT="5432"
DB_USER="postgres.TU_PROJECT_REF"
DB_PASSWORD="TU_PASSWORD_TAL_CUAL"
DB_NAME="postgres"

# 3. Conexión directa (Requiere red con soporte IPv6)
DATABASE_URL="postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres"

# 4. Conexión mediante SDK de Supabase para Python
# En Supabase: Project Settings -> API
SUPABASE_URL="https://TU_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="tu_clave_publica_anon_aqui"
