# ==============================================================================
# 🔑 ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env)
# ==============================================================================
# Copia este archivo como '.env' y reemplaza los valores con tus credenciales reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONEXIÓN RECOMENDADA: Session Pooler (Soporte IPv4 garantizado)
# ------------------------------------------------------------------------------
# La encuentras en: Project Settings -> Database -> Connection string -> Mode: Session
# ⚠️ NOTA: Si tu contraseña contiene caracteres especiales como '@', codifícalos con %40.
# Ejemplo: si tu clave es 'Pepito@123@@', escribe 'Pepito%40123%40%40'
DATABASE_SES_URL="postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. CONEXIÓN POR VARIABLES INDIVIDUALES (¡Ideal si tu clave tiene '@'!)
# ------------------------------------------------------------------------------
# Al pasar la contraseña en su propio campo, NO necesitas codificar nada con '%40':
DB_HOST="aws-0-eu-central-1.pooler.supabase.com"
DB_PORT="5432"
DB_USER="postgres.TU_PROJECT_REF"
DB_PASSWORD="TU_PASSWORD_TAL_CUAL"
DB_NAME="postgres"

# ------------------------------------------------------------------------------
# 3. CONEXIÓN DIRECTA (Solo funciona si tu red doméstica soporta IPv6)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 4. CREDENCIALES PARA EL SDK OFICIAL (@supabase/supabase-js)
# ------------------------------------------------------------------------------
# Las encuentras en: Project Settings -> API
SUPABASE_URL="https://TU_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="tu_clave_publica_anon_aqui"
