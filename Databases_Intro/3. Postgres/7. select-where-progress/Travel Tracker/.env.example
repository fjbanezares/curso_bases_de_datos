# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo a ".env" en esta misma carpeta:
#    cp .env.example .env
# 2. Rellena tus valores reales en el archivo ".env".
# 3. NUNCA subas el archivo ".env" a GitHub ni lo compartas con alumnos.
# ==============================================================================

# Configuración de PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=world
DB_PASSWORD=tu_contraseña_aqui
DB_PORT=5432

# Puerto del servidor web
PORT=3000
